# ==============================================================================
# Confluent Cloud Kafka Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env or use these parameters to populate client.properties.
# Replace the placeholder values with your Confluent Cloud cluster credentials.
# ==============================================================================

# Confluent Cloud Bootstrap Server (e.g. pkc-xxxxx.region.provider.confluent.cloud:9092)
BOOTSTRAP_SERVERS=your-confluent-bootstrap-server:9092

# Security Protocol & SASL Authentication
SECURITY_PROTOCOL=SASL_SSL
SASL_MECHANISMS=PLAIN

# Confluent Cloud API Key & Secret (Cluster or API Credentials)
SASL_USERNAME=YOUR_CONFLUENT_API_KEY
SASL_PASSWORD=YOUR_CONFLUENT_API_SECRET

# Kafka Topic Name
KAFKA_TOPIC=tax-evaluation-applications

# Consumer Group Configurations
CLI_CONSUMER_GROUP=tax_evaluation_group
DASHBOARD_CONSUMER_GROUP=dashboard_consumer_group
AUTO_OFFSET_RESET=earliest

# Client Session Timeout (milliseconds)
SESSION_TIMEOUT_MS=45000
